# Copiar a .env y completar localmente. Nunca publicar credenciales.
MONGO_MODE=atlas
ATLAS_URI=mongodb+srv://cluster.example.mongodb.net/
ATLAS_USUARIO=
ATLAS_CLAVE=
ATLAS_BASE=nexolicit_dev
ATLAS_AUTHDB=admin
APP_MODE=local
PUBLIC_ORIGIN=http://localhost:8000
# Vacío hasta confirmar explícitamente la interpretación de fechas de SICOP.
# America/Costa_Rica permite normalizar fechas sin offset; su uso queda registrado.
SICOP_TIMEZONE=
# Vacío deshabilita la caché. Para servidor compartido usar usuario ACL exclusivo.
REDIS_URL=

# Elegir un identificador único y estable por instalación.
INSTALLATION_ID=nexolicit-demo
ENVIRONMENT=development
REDIS_NAMESPACE=nexolicitcr
CACHE_TTL_SECONDS=120
CACHE_TIMEOUT_MS=150
CACHE_BREAKER_SECONDS=30
JOB_LEASE_SECONDS=90
JOB_MAX_ATTEMPTS=3
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_MAX_PAGES=30
DOCUMENT_MAX_FILES=5
EXTRACTION_TIMEOUT_SECONDS=120
# Agregar únicamente hosts exactos de almacenamiento verificados en SICOP.
DOCUMENT_HOSTS=www.sicop.go.cr,prod-api.sicop.go.cr

# Pausa mínima entre peticiones del worker a SICOP.
SICOP_REQUEST_DELAY_SECONDS=2
