# Copiar a .env.atlas o generarlo con scripts/configure_atlas.py.
# Esta configuración usa Docker en localhost con MongoDB Atlas externo.
MONGO_MODE=atlas
ATLAS_URI=mongodb+srv://cluster.example.mongodb.net/?retryWrites=true&w=majority
ATLAS_USUARIO=
ATLAS_CLAVE=
ATLAS_BASE=nexolicit_docker
ATLAS_AUTHDB=admin
MONGO_TIMEOUT_MS=15000
APP_MODE=local
PUBLIC_ORIGIN=http://localhost:8000
SICOP_TIMEZONE=America/Costa_Rica
INSTALLATION_ID=nexolicit-docker
ENVIRONMENT=development
# Para probar el perfil cache: redis://redis:6379/0
REDIS_URL=
